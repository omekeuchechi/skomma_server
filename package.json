{
  "name": "skomma_server",
  "private": true,
  "version": "0.1.0",
  "description": "Skomma Server - the backend API for the Skomma 2D live stream world",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist --sourcemap --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:ping": "tsx src/scripts/dbPing.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/websocket": "^11.3.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.8",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "mongodb": "^6.21.0",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
