# Skomma Server environment variables
# Copy this file to .env and adjust the values. Never commit .env.

# HTTP server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PREFIX=/api/v1

# MongoDB connection string (used by the native MongoDB driver)
# Local MongoDB:
#   DATABASE_URL=mongodb://127.0.0.1:27017/skomma
# MongoDB Atlas (mongodb+srv://):
#   DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skomma
#
# If you get "querySrv ECONNREFUSED" on Windows (Node's resolver fails while
# nslookup/resolve-dnsname work), bypass SRV with the direct connection string.
# Use the hostnames + replicaSet from the cluster's SRV/TXT records, e.g.:
#   DATABASE_URL=mongodb://<user>:<password>@host-00.example.mongodb.net:27017,host-01.example.mongodb.net:27017,host-02.example.mongodb.net:27017/skomma?authSource=admin&replicaSet=atlas-xxxxxx-shard-0&tls=true&retryWrites=true
DATABASE_URL=mongodb://127.0.0.1:27017/skomma

# Redis connection (BullMQ queues, caching, pub/sub)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma separated origins, or * for all)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Asset repository base URL (GitHub raw or CDN)
ASSET_REPOSITORY_BASE_URL=https://raw.githubusercontent.com/omekeuchechi/skomma_assests/main


